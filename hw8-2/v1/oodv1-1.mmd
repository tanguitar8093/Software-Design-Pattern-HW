classDiagram
    direction TB

    %% ============================================================
    %% OODv1-1：與 hw8-2/v1 實際程式碼同步的設計圖 (非分析圖)
    %% 相較於 OOA-Clean.mmd，此圖補齊了：
    %% 1. Bot 內部真正用來記錄狀態的 BotState 列舉與相關私有欄位
    %% 2. Bot <-> WaterballCommunity 的關聯（原圖遺漏）
    %% 3. ChatRoom/Forum/Broadcast 反向持有 Bot 參考（用於事件回呼）
    %% 4. 各類別內部私有的資料結構（-members、-posts、-scores...）
    %% 若程式碼再變動，請同步更新本檔，避免再次與實作脫節。
    %% ============================================================

    class WaterballCommunity {
        +currentTime: DateTime
        -members: Dict~String, Member~
        -memberOrder: List~String~
        +chatRoom: ChatRoom
        +forum: Forum
        +broadcast: Broadcast
        +bot: Bot
        +login(member: Member) void
        +logout(participantId: String) void
        +elapseTime(amount: int, unit: String) void
        +getOnlineCount() int
        +getOnlineMemberIds() List~String~
        +getMember(memberId: String) Member
    }

    class Participant {
        <<abstract>>
        +id: String
    }

    class Member {
        +role: Role
        +sendMessage(chatRoom: ChatRoom, content: String, tags: List~String~) void
        +publishPost(forum: Forum, id: String, title: String, content: String, tags: List~String~) void
        +commentPost(forum: Forum, postId: String, content: String, tags: List~String~) void
        +startBroadcast(broadcast: Broadcast) void
        +speak(broadcast: Broadcast, content: String) void
        +stopBroadcast(broadcast: Broadcast) void
    }

    class Role {
        <<enumeration>>
        ADMIN
        MEMBER
    }

    class BotState {
        <<enumeration>>
        NORMAL_DEFAULT
        NORMAL_INTERACTING
        RECORD_WAITING
        RECORD_RECORDING
        KING_QUESTIONING
        KING_THANKS
    }

    class Bot {
        +id: String = "bot"
        +quota: int
        +state: BotState
        +replyCycleIndex: int
        -community: WaterballCommunity
        +chatRoom: ChatRoom
        +forum: Forum
        +broadcast: Broadcast
        -recorderId: String
        -recordingSession: RecordingSession
        -game: KnowledgeKingGame
        -thanksEnteredAt: DateTime
        +bindChannels(chatRoom: ChatRoom, forum: Forum, broadcast: Broadcast) void
        +onMessageReceived(message: Message) void
        +onPostPublished(post: Post) void
        +onVoiceSpoken(voiceMessage: VoiceMessage) void
        +onBroadcastStarted(speakerId: String) void
        +onBroadcastStopped(speakerId: String) void
        +onTimeElapsed(seconds: int) void
        +onParticipantLoggedIn() void
        +onParticipantLoggedOut() void
        +replyChatMessage(content: String, tags: List~String~) void
        +commentPost(postId: String, content: String, tags: List~String~) void
        +broadcastVoice(content: String) void
        -replyCycle(authorId: String) void
        -handleAnswer(message: Message) void
        -handleCommand(message: Message, tagged: bool) void
        -executeCommand(permitted: bool, cost: int, effect) void
        -isAdmin(memberId: String) bool
        -startKnowledgeKing() void
        -restartKnowledgeKing() void
        -announceCurrentQuestion() void
        -enterThanksForJoining() void
        -startRecord(recorderId: String) void
        -stopRecording() void
        -enterNormalState() void
    }

    class ChatRoom {
        -bot: Bot
        +postMessage(message: Message) void
    }

    class Message {
        +authorId: String
        +content: String
        +tags: List~String~
    }

    class Forum {
        -bot: Bot
        -posts: Dict~String, Post~
        +createPost(post: Post) void
        +addComment(postId: String, comment: Comment) void
    }

    class Post {
        +id: String
        +authorId: String
        +title: String
        +content: String
        +tags: List~String~
        +comments: List~Comment~
        +addComment(comment: Comment) void
    }

    class Comment {
        +authorId: String
        +content: String
        +tags: List~String~
    }

    class Broadcast {
        -bot: Bot
        +currentSpeakerId: String
        +start(speakerId: String) void
        +speak(voiceMessage: VoiceMessage) void
        +stop(speakerId: String) void
        +isBroadcasting() bool
    }

    class VoiceMessage {
        +speakerId: String
        +content: String
    }

    class RecordingSession {
        +recorderId: String
        -voices: List~String~
        +addVoice(message: VoiceMessage) void
        +generateReplay() String
    }

    class KnowledgeKingGame {
        +currentQuestionIndex: int
        +startTime: DateTime
        -scores: Dict~String, int~
        +getCurrentQuestion() Question
        +submitAnswer(memberId: String, answer: String) bool
        +isFinished() bool
        +isTimeout(currentTime: DateTime) bool
        +getWinner() String
    }

    class Question {
        +number: int
        +description: String
        +options: List~String~
        +correctAnswer: String
        +isCorrect(answer: String) bool
    }

    note for KnowledgeKingGame "QUESTION_BANK 為模組層級共用常數(3 題固定考題)，所有 KnowledgeKingGame 實例共享同一份 Question，而非各自持有專屬複本"

    %% 繼承關係
    Participant <|-- Member
    Participant <|-- Bot
    Member --> Role
    Bot --> BotState

    %% 社群整體聚合
    WaterballCommunity "1" *-- "1" ChatRoom : 擁有
    WaterballCommunity "1" *-- "1" Forum : 擁有
    WaterballCommunity "1" *-- "1" Broadcast : 擁有
    WaterballCommunity "1" *-- "1" Bot : 常駐
    WaterballCommunity "1" o-- "0..*" Member : 在線成員名冊

    %% Bot 與頻道的雙向關聯 (v1 為手動接線，非 Observer Pattern)
    Bot --> WaterballCommunity : 查詢在線人數/成員/目前時間
    Bot --> ChatRoom : 發送訊息
    Bot --> Forum : 發表留言
    Bot --> Broadcast : 廣播語音
    ChatRoom --> Bot : 通報收到訊息
    Forum --> Bot : 通報新貼文
    Broadcast --> Bot : 通報上麥/發言/下麥

    %% 訊息與內容關聯
    ChatRoom "1" *-- "0..*" Message
    Forum "1" *-- "0..*" Post
    Post "1" *-- "0..*" Comment
    Broadcast "1" *-- "0..*" VoiceMessage

    %% Bot 持有的活動狀態
    Bot "1" o-- "0..1" RecordingSession : 進行錄音會話
    Bot "1" o-- "0..1" KnowledgeKingGame : 主持知識王遊戲
    KnowledgeKingGame "1" *-- "3" Question : 包含題庫
    RecordingSession "1" o-- "0..*" VoiceMessage : 記錄語音內容

    %% 互動行為便條紙
    note for Member "【Member 互動行為】<br/>1. 交流/下指令：呼叫 ChatRoom.postMessage(Message)<br/>2. 論壇發布/回文：呼叫 Forum.createPost(Post)、Forum.addComment(postId, Comment)<br/>3. 語音廣播：呼叫 Broadcast.start(id)、Broadcast.speak(VoiceMessage)、Broadcast.stop(id)"

    note for Bot "【Bot 互動行為】<br/>1. onMessageReceived 先依 state 做預設反應（正常狀態輪播回覆／知識王出題狀態核對答案），再檢查是否觸發指令（king/record/stop-recording/king-stop/play again）<br/>2. onPostPublished 依 state 決定留言內容（Nice post／標記全員）<br/>3. onParticipantLoggedIn/Out 依線上人數門檻在 NORMAL_DEFAULT ↔ NORMAL_INTERACTING 間切換並重置 replyCycleIndex<br/>4. onTimeElapsed 檢查知識王 1 小時逾時、感謝參與 20 秒倒數"

    note for KnowledgeKingGame "【KnowledgeKingGame 互動行為】<br/>1. 答題評分：Bot 收到 @bot 答案後呼叫 submitAnswer(memberId, ans)，內部比對 Question.isCorrect()，答對者於 scores 累加 1 分<br/>2. 判斷獲勝：Bot 於 3 題答完或 1 小時超時後呼叫 getWinner() 依 scores 結算贏家或 Tie"

    note for RecordingSession "【RecordingSession 互動行為】<br/>1. 累積語音：Bot 在講者說話時操作 addVoice(VoiceMessage) 逐筆記錄<br/>2. 產出內容：結束錄音時 Bot 呼叫 generateReplay() 取得整合文字格式發送到聊天室，並清空 voices"
