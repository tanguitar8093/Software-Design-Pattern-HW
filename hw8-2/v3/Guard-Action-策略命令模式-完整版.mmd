classDiagram
    direction TB

    %% ============================================================
    %% FSM 核心抽象：State + Event + Guard + Action + Transition
    %% 這版固定對應便條紙中的職責與互動操作
    %% ============================================================

    class FiniteStateMachine {
        +currentState: State
        +transitions: List~Transition~
        +dispatch(event: Event, context: TransitionContext)
        +addTransition(transition: Transition)
        +enterInitialState()
    }
    note for FiniteStateMachine "總控中心\n事件分派與狀態切換"

    class State {
        +id: String
        +entryAction: Action
        +exitAction: Action
        +enter()
        +exit()
    }
    note for State "現在在哪\n進出時做什麼"

    class Event {
        +name: String
        +payload: Map<String, Object>
        +getName()
        +getPayload()
    }
    note for Event "外界發生了什麼事"

    class Trigger {
        +acceptedEvent: Event
        +fromState: State
        +guard: Guard
        +transition: Transition
        +match(event: Event, state: State)
        +fire(context: TransitionContext)
    }
    note for Trigger "事件到轉移的啟動器"

    class Transition {
        +from: State
        +to: State
        +event: Event
        +guard: Guard
        +action: Action
        +canTrigger(event: Event, state: State, context: TransitionContext)
        +execute(context: TransitionContext)
    }
    note for Transition "A 到 B 的一條轉移規則"

    %% ------------------------------------------------------------
    %% Guard / Action 介面
    %% ------------------------------------------------------------
    class Guard {
        <<interface>>
        +evaluate(context: TransitionContext) bool
    }
    note for Guard "轉移前的條件判斷器"

    class Action {
        <<interface>>
        +execute(context: TransitionContext) void
    }
    note for Action "轉移成立後真正做的事"

    %% ------------------------------------------------------------
    %% 共用資料上下文
    %% ------------------------------------------------------------
    class TransitionContext {
        +sourceId: String
        +content: String
        +role: Role
        +quota: int
        +onlineCount: int
        +recorderId: String
        +isBroadcasting: bool
        +stateEnteredAt: DateTime
        +currentTime: DateTime
        +postId: String
        +game: KnowledgeKingGame
        +session: RecordingSession
        +voiceMessage: VoiceMessage
        +receiver: Object
    }
    note for TransitionContext "Guard/Action 共用資料倉庫"

    %% ------------------------------------------------------------
    %% Guard 家族（策略模式）
    %% ------------------------------------------------------------
    class RoleGuard {
        +requiredRole: Role
        +evaluate(context: TransitionContext) bool
    }
    note for RoleGuard "角色門禁"

    class QuotaGuard {
        +requiredAmount: int
        +evaluate(context: TransitionContext) bool
    }
    note for QuotaGuard "額度門禁"

    class RecorderGuard {
        +evaluate(context: TransitionContext) bool
    }
    note for RecorderGuard "錄音者身份門禁"

    class ParticipantCountGuard {
        +threshold: int
        +comparator: Comparator
        +evaluate(context: TransitionContext) bool
    }
    note for ParticipantCountGuard "在線人數門檻"

    class BroadcastingGuard {
        +expected: bool
        +evaluate(context: TransitionContext) bool
    }
    note for BroadcastingGuard "廣播狀態判斷"

    class GameFinishedGuard {
        +evaluate(context: TransitionContext) bool
    }
    note for GameFinishedGuard "知識王遊戲是否結束"

    class GameTimeoutGuard {
        +evaluate(context: TransitionContext) bool
    }
    note for GameTimeoutGuard "知識王是否超時"

    class AnswerCorrectGuard {
        +evaluate(context: TransitionContext) bool
    }
    note for AnswerCorrectGuard "答案是否正確"

    class StateDurationGuard {
        +thresholdSeconds: int
        +evaluate(context: TransitionContext) bool
    }
    note for StateDurationGuard "狀態停留時間是否達門檻"

    class Comparator {
        <<enumeration>>
        GTE
        LT
    }

    Guard <|.. RoleGuard
    Guard <|.. QuotaGuard
    Guard <|.. RecorderGuard
    Guard <|.. ParticipantCountGuard
    Guard <|.. BroadcastingGuard
    Guard <|.. GameFinishedGuard
    Guard <|.. GameTimeoutGuard
    Guard <|.. AnswerCorrectGuard
    Guard <|.. StateDurationGuard
    ParticipantCountGuard "1" --> "1" Comparator : 使用
    Guard ..> TransitionContext : 讀取

    %% ------------------------------------------------------------
    %% Action 家族（命令模式）
    %% ------------------------------------------------------------
    class DeductQuotaAction {
        +amount: int
        +execute(context: TransitionContext) void
    }
    note for DeductQuotaAction "扣額度"

    class ReplyChatMessageAction {
        +content: String
        +execute(context: TransitionContext) void
    }
    note for ReplyChatMessageAction "聊天室回覆"

    class CommentOnPostAction {
        +content: String
        +tagAllOnline: bool
        +execute(context: TransitionContext) void
    }
    note for CommentOnPostAction "發表論壇留言"

    class BroadcastVoiceAction {
        +content: String
        +execute(context: TransitionContext) void
    }
    note for BroadcastVoiceAction "廣播語音內容"

    class CreateRecordingSessionAction {
        +execute(context: TransitionContext) void
    }
    note for CreateRecordingSessionAction "建立錄音 Session"

    class CreateKnowledgeKingGameAction {
        +execute(context: TransitionContext) void
    }
    note for CreateKnowledgeKingGameAction "建立知識王遊戲"

    class AddVoiceMessageAction {
        +execute(context: TransitionContext) void
    }
    note for AddVoiceMessageAction "追加語音訊息"

    class ResetReplyCycleAction {
        +execute(context: TransitionContext) void
    }
    note for ResetReplyCycleAction "重設對話輪播"

    Action <|.. DeductQuotaAction
    Action <|.. ReplyChatMessageAction
    Action <|.. CommentOnPostAction
    Action <|.. BroadcastVoiceAction
    Action <|.. CreateRecordingSessionAction
    Action <|.. CreateKnowledgeKingGameAction
    Action <|.. AddVoiceMessageAction
    Action <|.. ResetReplyCycleAction
    Action ..> TransitionContext : 讀取/寫入

    class Role {
        <<enumeration>>
        ADMIN
        MEMBER
    }

    %% ------------------------------------------------------------
    %% 核心互動關係
    %% ------------------------------------------------------------
    FiniteStateMachine --> State : currentState
    FiniteStateMachine --> Transition : 管理規則
    FiniteStateMachine ..> Event : dispatch(event)
    FiniteStateMachine ..> Trigger : 觸發檢查

    Transition --> State : from / to
    Transition --> Event : event
    Transition --> Guard : guard
    Transition --> Action : action

    Trigger --> Event : acceptedEvent
    Trigger --> State : fromState
    Trigger --> Guard : guard
    Trigger --> Transition : transition

    State --> Action : entryAction / exitAction
    Guard ..> TransitionContext : evaluate(ctx)
    Action ..> TransitionContext : execute(ctx)
    TransitionContext --> Role : role
    TransitionContext --> Comparator : 比較條件資料

