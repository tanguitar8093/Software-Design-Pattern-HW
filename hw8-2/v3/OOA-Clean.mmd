classDiagram
    direction TB

    %% ======================= 觀察者模式 (Observer Pattern) =======================
    %% Force-擴充性：擴充新的 <觀察者> 時，不必修改既有 <EventPublisher>
    %% Force-行為變動性：Bot 對於不同 <事件> 皆得到不同的響應結果，且需一致的通知管道

    class DomainEvent {
        <<interface>>
        +getSourceId() String
    }

    note for DomainEvent "【getSourceId() 對應各事件的發起者欄位】<br/>MessagePostedEvent/PostCreatedEvent/CommentAddedEvent → 轉發被包裝內容的 authorId；VoiceSpokenEvent → 轉發 VoiceMessage.speakerId；LoginEvent/LogoutEvent → userId；BroadcastStartedEvent/BroadcastStoppedEvent → speakerId；TimeElapsedEvent 無發起者，回傳 null"

    class MessagePostedEvent {
        +message: Message
        +getSourceId() String
    }

    class PostCreatedEvent {
        +post: Post
        +getSourceId() String
    }

    class CommentAddedEvent {
        +comment: Comment
        +getSourceId() String
    }

    class VoiceSpokenEvent {
        +voiceMessage: VoiceMessage
        +getSourceId() String
    }

    note for MessagePostedEvent "【Wrapper Event】getSourceId() 回傳 message.authorId；ChatRoom.postMessage() 內部建立本事件包裝 Message 後才呼叫 notify()"

    note for PostCreatedEvent "【Wrapper Event】getSourceId() 回傳 post.authorId；Forum.createPost() 內部建立本事件包裝 Post 後才呼叫 notify()"

    note for CommentAddedEvent "【Wrapper Event】getSourceId() 回傳 comment.authorId；Forum.addComment() 內部建立本事件包裝 Comment 後才呼叫 notify()"

    note for VoiceSpokenEvent "【Wrapper Event】getSourceId() 回傳 voiceMessage.speakerId；Broadcast.speak() 內部建立本事件包裝 VoiceMessage 後才呼叫 notify()"

    class CommunityObserver {
        <<interface>>
        +getId() String
        +onEvent(event: DomainEvent) void
    }

    note for CommunityObserver "【getId() 用於比對事件來源】<br/>Bot 透過繼承 Participant 的 id 欄位實作 getId()，回傳 this.id（預設值為 bot），供 EventPublisher.notify() 判斷是否為自己發起的事件"

    class EventPublisher {
        -observers: List~CommunityObserver~
        +register(observer: CommunityObserver) void
        +unregister(observer: CommunityObserver) void
        +notify(event: DomainEvent) void
    }

    note for EventPublisher "【共用單一實例，而非繼承】<br/>EventPublisher 是具體類別，WaterballCommunity 只組合(has-a)一顆實例；ChatRoom/Forum/Broadcast 皆不繼承它，而是各自持有對它的參考(use-a)，在自身動作完成後呼叫同一顆實例的 notify(event)：<br/>notify(event):<br/>for all o in observers { if o.getId() != null and o.getId() == event.getSourceId(): continue; o.onEvent(event) }<br/>【防迴音(Echo Suppression)】不通知事件發起者自己，此規則統一寫在 EventPublisher，未來新增 Observer 不必各自重複判斷"

    class LoginEvent {
        +userId: String
        +isAdmin: bool
    }

    class LogoutEvent {
        +userId: String
    }

    class BroadcastStartedEvent {
        +speakerId: String
    }

    class BroadcastStoppedEvent {
        +speakerId: String
    }

    class TimeElapsedEvent {
        +amount: int
        +unit: String
    }

    %% ======================= 狀態模式 (State Pattern) =======================
    %% Force-擴充性：擴充新的 <狀態> 時，不必修改既有 <Bot>
    %% Force-行為變動性：Bot 在不同 <狀態> 下對同一 <事件> 的響應皆不同

    class BotState {
        <<interface>>
        +onEvent(bot: Bot, event: DomainEvent) void
    }

    class DefaultConversationState {
        +replyCycleIndex: int
        +getNextReplyMessage() String
    }

    class InteractingState {
        +replyCycleIndex: int
        +getNextReplyMessage() String
    }

    class WaitingState {
    }

    class RecordingState {
        +session: RecordingSession
    }

    class QuestioningState {
        +game: KnowledgeKingGame
    }

    class ThanksForJoiningState {
        +game: KnowledgeKingGame
    }

    class WaterballCommunity {
        +currentTime: DateTime
        +login(participant: Participant) void
        +logout(participantId: String) void
        +elapseTime(amount: int, unit: String) void
        +getOnlineParticipants() List~Participant~
        +getOnlineCount() int
    }

    class Participant {
        <<abstract>>
        +id: String
    }

    class Member {
        +role: Role
        +sendMessage(chatRoom: ChatRoom, content: String, tags: List~String~) void
        +publishPost(forum: Forum, title: String, content: String, tags: List~String~) void
        +commentPost(forum: Forum, postId: String, content: String, tags: List~String~) void
        +startBroadcast(broadcast: Broadcast) void
        +speak(broadcast: Broadcast, content: String) void
        +stopBroadcast(broadcast: Broadcast) void
    }

    class Role {
        <<enumeration>>
        ADMIN
        MEMBER
    }

    class Bot {
        +id: String = "bot"
        +quota: int
        +currentState: BotState
        +onEvent(event: DomainEvent) void
        +transitionTo(state: BotState) void
        +replyChatMessage(content: String, tags: List~String~) void
        +commentPost(postId: String, content: String, tags: List~String~) void
        +broadcastVoice(content: String) void
    }

    class ChatRoom {
        +postMessage(message: Message) void
    }

    class Message {
        +authorId: String
        +content: String
        +tags: List~String~
    }

    class Forum {
        +createPost(post: Post) void
        +addComment(postId: String, comment: Comment) void
    }

    class Post {
        +id: String
        +authorId: String
        +title: String
        +content: String
        +tags: List~String~
        +addComment(comment: Comment) void
    }

    class Comment {
        +authorId: String
        +content: String
        +tags: List~String~
    }

    class Broadcast {
        +currentSpeakerId: String
        +start(speakerId: String) void
        +speak(voiceMessage: VoiceMessage) void
        +stop(speakerId: String) void
        +isBroadcasting() bool
    }

    class VoiceMessage {
        +speakerId: String
        +content: String
    }

    class RecordingSession {
        +recorderId: String
        +addVoice(message: VoiceMessage) void
        +generateReplay() String
    }

    class KnowledgeKingGame {
        +currentQuestionIndex: int
        +startTime: DateTime
        +getCurrentQuestion() Question
        +submitAnswer(memberId: String, answer: String) bool
        +isFinished() bool
        +isTimeout(currentTime: DateTime) bool
        +getWinner() String
    }

    class Question {
        +number: int
        +description: String
        +options: List~String~
        +correctAnswer: String
        +isCorrect(answer: String) bool
    }

    %% ======================= [v3-STEP1] 策略模式 (Strategy Pattern) - FSM Guard =======================
    %% Force-通用性：FSM 模組不可認識「額度」「管理員」「在線人數」等 Waterball 社群業務概念
    %% Force-擴充性：擴充新的 <Guard> 條件時，不必修改既有 <Transition>/<FiniteStateMachine>（本步驟尚未建立這兩者，將於後續步驟接上）
    %% 依據(README原文)：「FSM 模組並不知曉『社群機器人』這個概念」「擴充新的 Trigger、Guard、Action⋯無需修改 FSM 模組的既有程式碼」

    %% ======================= [v3-STEP2] 命令模式 (Command Pattern) - FSM Action =======================
    %% Force-通用性：FSM 模組不可認識「扣額度」「回覆訊息」「留言」「廣播語音」等具體副作用內容
    %% Force-擴充性：擴充新的 <Action> 行為時，不必修改既有 <Transition>/<State>/<FiniteStateMachine>
    %% Force-可組合性：Entry Action / Exit Action / Transition Action 可能需要依序執行多個副作用
    %% 依據(README原文)：「當機器人進入此狀態時，會先做『進場行為』；離開此狀態時，則做『出場行為』」「擴充新的 Trigger、Guard、Action⋯無需修改 FSM 模組的既有程式碼」

    class TransitionContext {
        +sourceId: String
        +role: Role
        +quota: int
        +onlineCount: int
        +recorderId: String
        +receiver: Object
    }

    note for TransitionContext "【FSM 與業務資料的橋樑】TransitionContext 是 Guard/Action 存取轉移相關資料的唯一管道，由應用層在事件發生當下組裝後傳入；FSM 模組本身不需要知道這些欄位分別代表什麼業務意義，只單純轉手傳遞。<br/>【receiver 欄位(Command模式的Receiver)】receiver 是一個不具型別的通用參考(此處為 Bot 實例)，具體 Action 實作會將其向下轉型後呼叫對應方法(如 receiver.replyChatMessage())，FSM 核心與 Guard/Action 介面本身都不需要知道 receiver 實際型別"

    class Action {
        <<interface>>
        +execute(context: TransitionContext) void
    }

    note for Action "【命令模式(Command Pattern)】Action 是 FSM 模組唯一認識的抽象行為介面，對應 README 中 Entry Action / Exit Action / Transition Action 三種呼叫時機；具體副作用(扣額度/回覆訊息/留言/廣播語音)由應用層實作為不同的 Action，FSM 核心只呼叫 execute()，新增行為不需修改既有程式碼"

    class DeductQuotaAction {
        +amount: int
        +execute(context: TransitionContext) void
    }

    class ReplyChatMessageAction {
        +content: String
        +execute(context: TransitionContext) void
    }

    class CommentOnPostAction {
        +content: String
        +execute(context: TransitionContext) void
    }

    class BroadcastVoiceAction {
        +content: String
        +execute(context: TransitionContext) void
    }

    class CompositeAction {
        +actions: List~Action~
        +execute(context: TransitionContext) void
    }

    note for DeductQuotaAction "對應 README：king(額度5) / record(額度3) / play again(額度5) 指令觸發轉移時扣除對應額度；execute() 內部對 context.receiver(Bot) 執行 quota -= amount"
    note for ReplyChatMessageAction "對應 README：如「KnowledgeKing is started!」「KnowledgeKing is gonna start again!」等固定訊息回覆；execute() 呼叫 receiver.replyChatMessage(content, tags)"
    note for CommentOnPostAction "對應 README：如貼文底下留言『Nice post』；execute() 呼叫 receiver.commentPost(postId, content, tags)"
    note for BroadcastVoiceAction "對應 README：感謝參與狀態透過語音公布遊戲結果；execute() 呼叫 receiver.broadcastVoice(content)"
    note for CompositeAction "【命令組合】用於同一次轉移需要依序執行多個副作用，例如某條轉移同時要「扣額度」+「回覆訊息」，對應 AndGuard 在 Guard 家族中的組合角色"

    class Guard {
        <<interface>>
        +evaluate(context: TransitionContext) bool
    }

    note for Guard "【策略模式】Guard 是 FSM 模組唯一認識的抽象條件介面。具體判斷邏輯(額度/身分/人數/錄音者)由應用層實作為不同的 Guard，FSM 核心只呼叫 evaluate()，新增條件不需修改既有程式碼"

    class RoleGuard {
        +requiredRole: Role
        +evaluate(context: TransitionContext) bool
    }

    class QuotaGuard {
        +requiredAmount: int
        +evaluate(context: TransitionContext) bool
    }

    class RecorderGuard {
        +evaluate(context: TransitionContext) bool
    }

    class ParticipantCountGuard {
        +threshold: int
        +comparator: Comparator
        +evaluate(context: TransitionContext) bool
    }

    class Comparator {
        <<enumeration>>
        GTE
        LT
    }

    class AndGuard {
        +guards: List~Guard~
        +evaluate(context: TransitionContext) bool
    }

    note for RoleGuard "對應 README：king / king-stop 指令『只有管理員方可使用』"
    note for QuotaGuard "對應 README：king(額度5) / record(額度3) / play again(額度5) 等指令的額度門檻檢查"
    note for RecorderGuard "對應 README：stop-recording『只有錄音者方可使用』；evaluate() 內部比對 context.sourceId == context.recorderId"
    note for ParticipantCountGuard "對應 README：登入後在線人數 >= 10 進互動狀態(comparator=GTE)；登出後在線人數 < 10 回預設對話狀態(comparator=LT)"
    note for AndGuard "【策略組合】用於同時滿足多個條件，例如 king 指令需要「RoleGuard(ADMIN) 且 QuotaGuard(5)」同時成立時才觸發轉移"

    %% 觀察者模式關係
    DomainEvent <|.. MessagePostedEvent
    DomainEvent <|.. PostCreatedEvent
    DomainEvent <|.. CommentAddedEvent
    DomainEvent <|.. VoiceSpokenEvent
    DomainEvent <|.. LoginEvent
    DomainEvent <|.. LogoutEvent
    DomainEvent <|.. BroadcastStartedEvent
    DomainEvent <|.. BroadcastStoppedEvent
    DomainEvent <|.. TimeElapsedEvent
    MessagePostedEvent "1" --> "1" Message : 包裝
    PostCreatedEvent "1" --> "1" Post : 包裝
    CommentAddedEvent "1" --> "1" Comment : 包裝
    VoiceSpokenEvent "1" --> "1" VoiceMessage : 包裝
    EventPublisher "1" o-- "0..*" CommunityObserver : - observers
    CommunityObserver <|.. Bot
    WaterballCommunity "1" *-- "1" EventPublisher : 統一發布中心
    ChatRoom "1" --> "1" EventPublisher : 使用
    Forum "1" --> "1" EventPublisher : 使用
    Broadcast "1" --> "1" EventPublisher : 使用
    Bot "1" --> "1" EventPublisher : 註冊

    %% 狀態模式關係
    BotState <|.. DefaultConversationState
    BotState <|.. InteractingState
    BotState <|.. WaitingState
    BotState <|.. RecordingState
    BotState <|.. QuestioningState
    BotState <|.. ThanksForJoiningState
    Bot "1" --> "1" BotState : currentState
    RecordingState "1" *-- "1" RecordingSession
    QuestioningState "1" *-- "1" KnowledgeKingGame
    ThanksForJoiningState "1" --> "1" KnowledgeKingGame

    %% [v3-STEP1] 策略模式關係
    Guard <|.. RoleGuard
    Guard <|.. QuotaGuard
    Guard <|.. RecorderGuard
    Guard <|.. ParticipantCountGuard
    Guard <|.. AndGuard
    AndGuard "1" o-- "2..*" Guard : 組合子條件
    ParticipantCountGuard "1" --> "1" Comparator : 使用
    Guard ..> TransitionContext : 讀取(evaluate 參數)

    %% [v3-STEP2] 命令模式關係
    Action <|.. DeductQuotaAction
    Action <|.. ReplyChatMessageAction
    Action <|.. CommentOnPostAction
    Action <|.. BroadcastVoiceAction
    Action <|.. CompositeAction
    CompositeAction "1" o-- "2..*" Action : 依序組合子行為
    Action ..> TransitionContext : 讀取/寫入(execute 參數)

    %% 繼承關係
    Participant <|-- Member
    Participant <|-- Bot
    Member --> Role

    %% 社群整體聚合
    WaterballCommunity "1" *-- "1" ChatRoom : 擁有
    WaterballCommunity "1" *-- "1" Forum : 擁有
    WaterballCommunity "1" *-- "1" Broadcast : 擁有
    WaterballCommunity "1" *-- "1" Bot : 常駐
    WaterballCommunity "1" o-- "0..*" Participant : 在線參與者

    %% 訊息與內容關聯
    ChatRoom "1" *-- "0..*" Message
    Forum "1" *-- "0..*" Post
    Post "1" *-- "0..*" Comment
    Broadcast "1" *-- "0..*" VoiceMessage

    %% 機器人主動操作社群組件
    Bot --> ChatRoom : 發送訊息
    Bot --> Forum : 發表留言
    Bot --> Broadcast : 廣播語音
    KnowledgeKingGame "1" *-- "3" Question : 包含題庫
    RecordingSession "1" o-- "0..*" VoiceMessage : 記錄語音內容

    %% 互動行為便條紙 (誰為了做甚麼事操作了誰的方法)
    note for Member "【Member 互動行為】<br/>1. 交流/下指令：呼叫 ChatRoom.postMessage(Message)<br/>2. 論壇發布/回文：呼叫 Forum.createPost(Post)、Forum.addComment(postId, Comment)<br/>3. 語音廣播：呼叫 Broadcast.start(id)、Broadcast.speak(VoiceMessage)、Broadcast.stop(id)<br/>4. 上述操作皆會使該 EventPublisher（ChatRoom/Forum/Broadcast/WaterballCommunity）呼叫 notify(event) 通知 Bot"

    note for ChatRoom "【ChatRoom 使用共用的 EventPublisher】<br/>postMessage(message) 內部除了輸出/保存訊息外，會將 message 包裝成 MessagePostedEvent，最後呼叫 WaterballCommunity 唯一那顆 EventPublisher 的 notify(new MessagePostedEvent(message))；ChatRoom 本身不持有 observers 清單，也不繼承任何發布邏輯"

    note for Forum "【Forum 使用共用的 EventPublisher】<br/>createPost(post)、addComment(postId, comment) 完成後，會分別包裝成 PostCreatedEvent/CommentAddedEvent，再呼叫同一顆 EventPublisher 的 notify(event)"

    note for Broadcast "【Broadcast 使用共用的 EventPublisher】<br/>start/speak/stop 完成後會分別呼叫同一顆 EventPublisher 的 notify(BroadcastStartedEvent)/notify(new VoiceSpokenEvent(voiceMessage))/notify(BroadcastStoppedEvent)"

    note for WaterballCommunity "【WaterballCommunity 擁有唯一的 EventPublisher】<br/>login/logout/elapseTime 完成後會呼叫自己組合持有的 EventPublisher 之 notify(LoginEvent)/notify(LogoutEvent)/notify(TimeElapsedEvent)；同時也是 ChatRoom/Forum/Broadcast 共用同一顆 EventPublisher 的來源"

    note for Bot "【Bot 觀察者行為】<br/>1. Bot 實作 CommunityObserver，只需向 WaterballCommunity 持有的那一顆 EventPublisher 註冊一次 register(this)，即可收到 ChatRoom/Forum/Broadcast/WaterballCommunity 四方共用同一發布中心送出的所有事件<br/>2. 任何 DomainEvent 發生時，onEvent(event) 皆會被統一呼叫，不需關心事件來源<br/>【Bot 狀態委派行為】<br/>3. onEvent(event) 內部委派給 currentState.onEvent(this, event) 處理，依當前狀態產生不同回應<br/>4. 狀態處理完畢後可能呼叫 transitionTo(newState) 切換至下一狀態<br/>【v3 現況】5. Bot/BotState 本次尚未接上 Guard/Action，權限/額度判斷與副作用執行邏輯仍暫留在 v2 原本位置，等步驟 3(Transition)、步驟 5(FiniteStateMachine) 建立後才會將這些邏輯改委派給 Guard/Action"

    note for BotState "【BotState 互動行為】<br/>1. 各具體狀態依事件類型（MessagePostedEvent/PostCreatedEvent/VoiceSpokenEvent/LoginEvent...）判斷是否為指令、是否符合權限與額度，決定呼叫 Bot.replyChatMessage()/commentPost()/broadcastVoice() 或 transitionTo()<br/>2. RecordingState 持有 RecordingSession 收音；QuestioningState 持有 KnowledgeKingGame 主持答題"

    note for KnowledgeKingGame "【KnowledgeKingGame 互動行為】<br/>1. 答題評分：QuestioningState 收到標記 bot 的 MessagePostedEvent 後取出 event.message 呼叫 submitAnswer(memberId, ans)，內部比對 Question.isCorrect()，答對者累加 1 分<br/>2. 判斷獲勝：3 題答完或 1 小時超時後由狀態呼叫 getWinner() 依分數結算贏家或 Tie"

    note for RecordingSession "【RecordingSession 互動行為】<br/>1. 累積語音：RecordingState 於講者說話時操作 addVoice(VoiceMessage) 逐筆記錄<br/>2. 產出內容：結束錄音時 RecordingState 呼叫 generateReplay() 取得整合文字格式發送到聊天室"
