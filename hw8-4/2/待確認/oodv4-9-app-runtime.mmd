classDiagram
    direction LR

    %% 最新 App 層 detail：依 hw8-5/main.py、hw8-5/v1/app/*、相關 community/events/bot 實作。
    %% 簡化版見 oodv4-9-app-overview.mmd；舊 oodv4-8 圖保留作設計演進紀錄。
    %% Client、EventLineParser、HandlerChainBuilder 是模組函式的圖面名稱，不是 Python 類別。
    %% 空行／沒有 ] 的輸入被 parser 略過；JSON／elapsed 格式錯誤可能在入鏈前拋出例外。

    class Client {
        <<CLI / main.py>>
        +main() void
    }
    class EventLineParser {
        <<module function / event_line_parser.py>>
        +parseLine(rawLine: str) ParsedEvent|None
    }
    class ParsedEvent {
        <<dataclass>>
        +name: InputEventType
        +payload: dict
        +rawName: str|None
    }
    class InputEventType {
        <<enumeration>>
        STARTED
        LOGIN
        LOGOUT
        ELAPSED
        NEW_MESSAGE
        NEW_POST
        GO_BROADCASTING
        SPEAK
        STOP_BROADCASTING
        END
        UNKNOWN
    }
    class AppDriver {
        -_context: HandlerContext
        -_handler_chain: EventHandler
        +output: list~str~
        +community: WaterCommunity|None
        +bot: Bot|None
        +__init__(output: list~str~|None, handler_chain: EventHandler|None)
        +run(lines: list~str~) list~str~
    }
    class HandlerContext {
        <<dataclass>>
        +output: list~str~
        +community: WaterCommunity|None
        +bot: Bot|None
    }
    class HandlerChainBuilder {
        <<module function / handler_chain.py>>
        +build_handler_chain() EventHandler
    }
    class HandlingResult {
        <<enumeration>>
        CONTINUE
        STOP
    }

    %% base.py：handle 是固定樣板；can_handle 與 execute 是變動點。
    class EventHandler {
        <<abstract / Chain of Responsibility + Template Method>>
        +event_type: InputEventType
        -_next_handler: EventHandler|None
        +__init__(next_handler: EventHandler|None)
        +handle(request: ParsedEvent, context: HandlerContext) HandlingResult
        +can_handle(request: ParsedEvent) bool
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
        +forward(request: ParsedEvent, context: HandlerContext) HandlingResult
    }

    %% lifecycle.py
    class StartedHandler {
        +event_type: STARTED
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
    }
    class EndHandler {
        +event_type: END
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
    }
    class UnknownEventHandler {
        <<terminal / catch-all>>
        +can_handle(request: ParsedEvent) bool
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
    }

    %% membership.py
    class LoginHandler {
        +event_type: LOGIN
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
    }
    class LogoutHandler {
        +event_type: LOGOUT
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
    }

    %% time.py
    class ElapsedHandler {
        +event_type: ELAPSED
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
    }

    %% content.py
    class NewMessageHandler {
        +event_type: NEW_MESSAGE
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
    }
    class NewPostHandler {
        +event_type: NEW_POST
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
    }

    %% broadcast.py
    class GoBroadcastingHandler {
        +event_type: GO_BROADCASTING
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
    }
    class SpeakHandler {
        +event_type: SPEAK
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
    }
    class StopBroadcastingHandler {
        +event_type: STOP_BROADCASTING
        +execute(request: ParsedEvent, context: HandlerContext) HandlingResult
    }

    %% App 之外：只展開本圖需要的接點。
    class WaterCommunity {
        +login(participant: Participant) void
        +logout(participantId: str) void
        +elapseTime(amount: int, unit: str) void
        +postMessage(authorId: str, content: str, tags: list~str~) void
        +createPost(id: str, authorId: str, title: str, content: str, tags: list~str~) void
        +addComment(postId: str, authorId: str, content: str, tags: list~str~) void
        +startBroadcast(speakerId: str) void
        +speak(speakerId: str, content: str) void
        +stopBroadcast(speakerId: str) void
        +getEventPublisher() EventPublisher
    }
    class Participant {
        <<abstract>>
        +id: str
    }
    class Member {
        +id: str
        +role: Role
    }
    class Role {
        <<enumeration>>
        ADMIN
        MEMBER
    }
    class BotFacade {
        +bot: Bot
        +__init__(community: WaterCommunity, quota: int, description: str)
    }
    class Bot {
        <<CommunityObserver>>
        +quota: int
        +getId() str
        +onEvent(event: DomainEvent) void
    }
    class CommunityObserver {
        <<interface>>
        +getId() str
        +onEvent(event: DomainEvent) void
    }
    class EventPublisher {
        +register(observer: CommunityObserver) void
        +notify(event: DomainEvent) void
    }
    class TranscriptObserver {
        <<CommunityObserver>>
        +output: list~str~
        +getId() str
        +onEvent(event: DomainEvent) void
        -_format(event: DomainEvent) str|None
    }
    class DomainEvent {
        <<abstract>>
        +getSourceId() str|None
    }
    class LoginEvent
    class LogoutEvent
    class TimeElapsedEvent
    class MessagePostedEvent
    class PostCreatedEvent
    class CommentAddedEvent {
        +postId: str
    }
    class BroadcastStartedEvent
    class VoiceSpokenEvent
    class BroadcastStoppedEvent

    %% CLI → parser → driver → chain；END 才令 driver 停止。
    Client ..> AppDriver : run(stdin lines) then print(output)
    AppDriver ..> EventLineParser : parseLine(rawLine)
    EventLineParser ..> ParsedEvent : creates
    EventLineParser ..> InputEventType : parse known names / UNKNOWN
    ParsedEvent --> InputEventType : name
    AppDriver *-- HandlerContext : _context
    AppDriver --> EventHandler : _handler_chain / optional injection
    AppDriver ..> HandlerChainBuilder : default build
    AppDriver ..> HandlingResult : stops on STOP
    HandlerChainBuilder ..> StartedHandler : first
    HandlerChainBuilder ..> LoginHandler : link
    HandlerChainBuilder ..> LogoutHandler : link
    HandlerChainBuilder ..> ElapsedHandler : link
    HandlerChainBuilder ..> NewMessageHandler : link
    HandlerChainBuilder ..> NewPostHandler : link
    HandlerChainBuilder ..> GoBroadcastingHandler : link
    HandlerChainBuilder ..> SpeakHandler : link
    HandlerChainBuilder ..> StopBroadcastingHandler : link
    HandlerChainBuilder ..> EndHandler : link
    HandlerChainBuilder ..> UnknownEventHandler : last

    %% Template Method：handle 呼叫 can_handle，接手則 execute，否則 forward 給 next。
    EventHandler --> EventHandler : _next_handler / forward
    EventHandler ..> ParsedEvent : matches request.name
    EventHandler ..> HandlingResult : execute result
    EventHandler <|-- StartedHandler
    EventHandler <|-- LoginHandler
    EventHandler <|-- LogoutHandler
    EventHandler <|-- ElapsedHandler
    EventHandler <|-- NewMessageHandler
    EventHandler <|-- NewPostHandler
    EventHandler <|-- GoBroadcastingHandler
    EventHandler <|-- SpeakHandler
    EventHandler <|-- StopBroadcastingHandler
    EventHandler <|-- EndHandler
    EventHandler <|-- UnknownEventHandler
    UnknownEventHandler ..> ParsedEvent : can_handle always true
    EndHandler ..> HandlingResult : STOP

    %% 事件處理時的共享狀態與網域操作；未 started 的事件由各 handler 消耗但不觸碰 community。
    HandlerContext --> WaterCommunity : community
    HandlerContext --> Bot : bot
    StartedHandler ..> WaterCommunity : create after positive quota validation
    StartedHandler ..> TranscriptObserver : register first
    StartedHandler ..> BotFacade : create second
    BotFacade --> Bot : create and register
    LoginHandler ..> Member : create
    Participant <|-- Member
    Member --> Role : role
    LoginHandler ..> WaterCommunity : login
    LogoutHandler ..> WaterCommunity : logout
    ElapsedHandler ..> WaterCommunity : elapseTime
    NewMessageHandler ..> WaterCommunity : postMessage
    NewPostHandler ..> WaterCommunity : createPost
    GoBroadcastingHandler ..> WaterCommunity : startBroadcast
    SpeakHandler ..> WaterCommunity : speak
    StopBroadcastingHandler ..> WaterCommunity : stopBroadcast

    %% 社群同步發布網域事件；TranscriptObserver 先訂閱、Bot 後訂閱。
    WaterCommunity *-- EventPublisher : owns
    EventPublisher o-- CommunityObserver : observers
    EventPublisher ..> DomainEvent : notify(event)
    CommunityObserver <|.. TranscriptObserver
    CommunityObserver <|.. Bot
    DomainEvent <|.. LoginEvent
    DomainEvent <|.. LogoutEvent
    DomainEvent <|.. TimeElapsedEvent
    DomainEvent <|.. MessagePostedEvent
    DomainEvent <|.. PostCreatedEvent
    DomainEvent <|.. CommentAddedEvent
    DomainEvent <|.. BroadcastStartedEvent
    DomainEvent <|.. VoiceSpokenEvent
    DomainEvent <|.. BroadcastStoppedEvent
    TranscriptObserver ..> TimeElapsedEvent : format
    TranscriptObserver ..> MessagePostedEvent : format member / bot
    TranscriptObserver ..> PostCreatedEvent : format
    TranscriptObserver ..> CommentAddedEvent : format only bot comments
    TranscriptObserver ..> BroadcastStartedEvent : format member / bot
    TranscriptObserver ..> VoiceSpokenEvent : format member / bot
    TranscriptObserver ..> BroadcastStoppedEvent : format member / bot
    %% LoginEvent / LogoutEvent 不輸出；Bot 仍收到，可能引發狀態轉移或新事件。
