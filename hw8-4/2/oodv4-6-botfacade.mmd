    %% ======================= 本檔案是 oodv4-5-bot-facade-consistency.mmd 的差異版，只新增下列項目 =======================
    %% 背景：hw8-5/v1 開始實作組裝層，發現兩件事需要補進類別圖：
    %% 1. 需要一個獨立的 BotFacade 類別，把「組一堆 State/Guard/Action/Trigger/Transition 才能生出
    %%    一個能動的 Bot」這件事包起來，App 層以後只認識 BotFacade，不需要知道 Bot 建構子要吃 rootFsm
    %%    這種內部細節。對照 hw8-5/景點-門面模式/v2 的 StatsFacade 設計邏輯。
    %% 2. 「同一個 leaf state 內、不換狀態也要發生的原地反應」（訊息輪播、留言）需要一個機制掛進 Bot，
    %%    但不能讓 FSM 模組（fsm/core.py）知道 Bot 的業務語意。新增 InternalReaction 類別解決，
    %%    它只重用 FSM 既有的 Trigger/Action 介面，放在 Bot 模組底下，不放進 fsm/。
    %% 改動項目：
    %% 1. 新增 BotFacade 類別（-bot: Bot），組裝完成後持有 Bot 實例
    %% 2. 新增 InternalReaction 類別（-state/-trigger/-action，+isApplicable()）
    %% 3. Bot 新增 -internalReactions: InternalReaction[*] 欄位、+addInternalReaction() 方法
    %% 4. Bot ..> StateNode：新增「沿 currentState 鏈走到底找 leaf state」這條依賴
    %% 詳細差異說明見 oodv4-6-botfacade-diff.md

    %% ======================= 社群基礎設施 (Waterball Community) =======================
    class WaterCommunity {
        -currentTime: DateTime
        +login(participant: Participant) void
        +logout(participantId: str) void
        +elapseTime(amount: int, unit: str) void
        +getOnlineParticipants() list~Participant~
        +getOnlineCount() int
        +getEventPublisher() EventPublisher
        +postBotReply(content: str, tags: list~str~) void
    }

    class Participant {
        <<abstract>>
        -id: str
    }

    class Member {
        -role: int
        +sendMessage(chatRoom: ChatRoom, content: str, tags: list~str~) void
        +publishPost(forum: Forum, title: str, content: str, tags: list~str~) void
        +commentPost(forum: Forum, postId: str, content: str, tags: list~str~) void
        +startBroadcast(broadcast: Broadcast) void
        +speak(broadcast: Broadcast, content: str) void
        +stopBroadcast(broadcast: Broadcast) void
    }

    class Role {
        <<enumeration>>
        ADMIN = "ADMIN"
        MEMBER = "MEMBER"
    }

    Participant <|-- Member
    Member --> Role : role
    WaterCommunity "1" o-- "0..*" Participant : 線上參與者
    WaterCommunity "1" *-- "1" ChatRoom : 擁有
    WaterCommunity "1" *-- "1" Forum : 擁有
    WaterCommunity "1" *-- "1" Broadcast : 擁有
    WaterCommunity "1" *-- "1" EventPublisher : 擁有

    %% ======================= 聊天室 / 論壇 / 廣播 =======================
    class ChatRoom {
        +postMessage(message: Message) void
    }

    class Message {
        -authorId: str
        -content: str
        -tags: list~str~
    }

    class Forum {
        +createPost(post: Post) void
        +addComment(postId: str, comment: Comment) void
        +getPost(id: str) Post
    }

    class Post {
        -id: str
        -authorId: str
        -title: str
        -content: str
        -tags: list~str~
        +addComment(comment: Comment) void
    }

    class Comment {
        -authorId: str
        -content: str
        -tags: list~str~
    }

    class Broadcast {
        -currentSpeakerId: str
        +start(speakerId: str) void
        +speak(voiceMessage: VoiceMessage) void
        +stop(speakerId: str) void
        +isBroadcasting() bool
    }

    class VoiceMessage {
        -speakerId: str
        -content: str
    }

    ChatRoom "1" o-- "0..*" Message
    Forum "1" o-- "0..*" Post
    Post "1" o-- "0..*" Comment
    Broadcast "1" o-- "0..*" VoiceMessage

    Member ..> ChatRoom : 交流 下指令
    Member ..> Forum : 論壇發布/留言
    Member ..> Broadcast : 語音廣播操作

