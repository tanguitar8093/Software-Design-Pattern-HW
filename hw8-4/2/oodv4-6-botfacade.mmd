    %% ======================= Domain Event / Event Publisher =======================
    class DomainEvent {
        <<interface>>
        +getSourceId() str|None
    }

    class MessagePostedEvent {
        -message: Message
        +getSourceId() str|None
    }
    class PostCreatedEvent {
        -post: Post
        +getSourceId() str|None
    }
    class CommentAddedEvent {
        -comment: Comment
        +getSourceId() str|None
    }
    class BroadcastStartedEvent {
        -speakerId: str
        +getSourceId() str|None
    }
    class BroadcastStoppedEvent {
        -speakerId: str
        +getSourceId() str|None
    }
    class VoiceSpokenEvent {
        -voiceMessage: VoiceMessage
        +getSourceId() str|None
    }
    class LoginEvent {
        -userId: str
        -isAdmin: bool
        +getSourceId() str|None
    }
    class LogoutEvent {
        -userId: str
        +getSourceId() str|None
    }
    class TimeElapsedEvent {
        -amount: int
        -unit: str
        +getSourceId() str|None
    }

    Event <|.. DomainEvent
    DomainEvent <|.. MessagePostedEvent
    DomainEvent <|.. PostCreatedEvent
    DomainEvent <|.. CommentAddedEvent
    DomainEvent <|.. BroadcastStartedEvent
    DomainEvent <|.. BroadcastStoppedEvent
    DomainEvent <|.. VoiceSpokenEvent
    DomainEvent <|.. LoginEvent
    DomainEvent <|.. LogoutEvent
    DomainEvent <|.. TimeElapsedEvent

    class CommunityObserver {
        <<interface>>
        +getId() str
        +onEvent(event: DomainEvent) void
    }

    class EventPublisher {
        -observers: list~CommunityObserver~
        +register(observer: CommunityObserver) void
        +unregister(observer: CommunityObserver) void
        +notify(event: DomainEvent) void
    }

    EventPublisher "1" o-- "0..*" CommunityObserver : observers
    ChatRoom ..> EventPublisher : notify(MessagePostedEvent)
    Forum ..> EventPublisher : notify(PostCreatedEvent/CommentAddedEvent)
    Broadcast ..> EventPublisher : notify(BroadcastStarted/Stopped/VoiceSpokenEvent)
    WaterCommunity ..> EventPublisher : notify(LoginEvent/LogoutEvent/TimeElapsedEvent)

