    }
    class MentionsBotTrigger {
        +isTriggeredBy(event: Event) bool
    }
    class LoginTrigger {
        +isTriggeredBy(event: Event) bool
    }
    class LogoutTrigger {
        +isTriggeredBy(event: Event) bool
    }
    class BroadcastStartedTrigger {
        +isTriggeredBy(event: Event) bool
    }
    class BroadcastStoppedTrigger {
        +isTriggeredBy(event: Event) bool
    }
    class TimeElapsedTrigger {
        +isTriggeredBy(event: Event) bool
    }

    Trigger <|.. CommandTrigger
    Trigger <|.. MentionsBotTrigger
    Trigger <|.. LoginTrigger
    Trigger <|.. LogoutTrigger
    Trigger <|.. BroadcastStartedTrigger
    Trigger <|.. BroadcastStoppedTrigger
    Trigger <|.. TimeElapsedTrigger

    CommandTrigger ..> MessagePostedEvent : 比對 content/tags
    MentionsBotTrigger ..> MessagePostedEvent : 比對 tags
    LoginTrigger ..> LoginEvent : 型別比對
    LogoutTrigger ..> LogoutEvent : 型別比對
    BroadcastStartedTrigger ..> BroadcastStartedEvent : 型別比對
    BroadcastStoppedTrigger ..> BroadcastStoppedEvent : 型別比對
    TimeElapsedTrigger ..> TimeElapsedEvent : 型別比對

