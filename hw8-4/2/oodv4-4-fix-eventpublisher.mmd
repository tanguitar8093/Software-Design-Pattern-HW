    %% ======================= FSM 模組（State/FSM 骨架，完整定義見 fsm-ooa-4.mmd） =======================
    class StateNode {
        <<interface>>
        +onEnter(event: Event) void
        +onExit(event: Event) void
        +fire(event: Event) bool
    }

    class State {
        +enter: Action
        +exit: Action
        +onEnter(event: Event) void
        +onExit(event: Event) void
        +fire(event: Event) bool
    }

    class FiniteStateMachine {
        -currentState: StateNode
        -initialStateSelector: InitialStateSelector
        -transitions: Transition[*]
        +addTransition(transition: Transition) void
        +fire(event: Event) bool
    }

    class InitialStateSelector {
        <<interface>>
        +select(event: Event) StateNode
    }

    StateNode <|.. State
    StateNode <|.. FiniteStateMachine
    FiniteStateMachine "1" --> "1" InitialStateSelector : initialStateSelector

    note for FiniteStateMachine "N9"
    note for InitialStateSelector "N36"

    class Guard {
        <<interface>>
        +isSatisfied(event: Event) bool
    }

    class Action {
        <<interface>>
        +execute(event: Event) void
    }

    note for Guard "N9"
    note for Action "N9"
    note for Guard "N38"

    %% ======================= 重用板 InitialStateSelector（Composite over Strategy，本圖直接使用） =======================
    class GuardedInitialStateSelector {
        -candidates: (Guard, StateNode)[*]
        -fallback: StateNode
        +select(event: Event) StateNode
    }

    InitialStateSelector <|.. GuardedInitialStateSelector
    GuardedInitialStateSelector "1" o-- "1..*" Guard : candidates
    GuardedInitialStateSelector "1" o-- "1..*" StateNode : candidates
    GuardedInitialStateSelector "1" --> "1" StateNode : fallback

    note for GuardedInitialStateSelector "N36"

    %% ======================= Bot 主體 =======================
    class Bot {
        -id: str = "bot"
        -quota: int
        -description: str
        -rootFsm: FiniteStateMachine
        +onEvent(event: DomainEvent) void
        +replyChatMessage(content: str, tags: list~str~) void
        +commentPost(postId: str, content: str, tags: list~str~) void
        +broadcastVoice(content: str) void
    }

    CommunityObserver <|.. Bot
    Bot "1" --> "1" FiniteStateMachine : rootFsm
    Bot ..> Forum : commentPost()
    Bot ..> Broadcast : broadcastVoice()
    Bot ..> WaterCommunity : getEventPublisher()
    Bot ..> WaterCommunity : postBotReply()
    Bot --> EventPublisher : register(this)
    WaterCommunity ..> ChatRoom : postMessage()

    note for Bot "N10"
    note for Bot "N37"
    note for Bot "N39"
    note for WaterCommunity "N39"

    %% ======================= 具體狀態（擴充 FSM 模組的 State） =======================
    class DefaultConversationState {
        -replyCycleIndex: int
        +getNextReplyMessage() str
    }
    class InteractingState {
        -replyCycleIndex: int
        +getNextReplyMessage() str
    }
    class WaitingState
    class RecordingState {
        -session: RecordingSession
    }
    class QuestioningState {
        -game: KnowledgeKingGame
    }
    class ThanksForJoiningState {
        -game: KnowledgeKingGame
    }

    State <|-- DefaultConversationState
    State <|-- InteractingState
    State <|-- WaitingState
    State <|-- RecordingState
    State <|-- QuestioningState
    State <|-- ThanksForJoiningState

    RecordingState "1" --> "0..1" RecordingSession : 進行錄音會話
    QuestioningState "1" --> "1" KnowledgeKingGame : 主持知識王遊戲
    ThanksForJoiningState "1" --> "1" KnowledgeKingGame : 主持知識王遊戲

    %% ======================= 錄音 / 知識王 子領域 =======================
    class RecordingSession {
        -recorderId: str
        +addVoice(message: VoiceMessage) void
        +generateReplay() str
    }
    RecordingSession ..> VoiceMessage : 使用

    class KnowledgeKingGame {
        -currentQuestionIndex: int
        -startTime: DateTime
        +getCurrentQuestion() Question
        +submitAnswer(memberId: str, answer: str) bool
        +isFinished() bool
        +isTimeout(currentTime: DateTime) bool
        +getWinner() str
    }
    class Question {
        -number: int
        -description: str
        -options: list~str~
        -correctAnswer: str
        +isCorrect(answer: str) bool
    }
    KnowledgeKingGame "1" o-- "3" Question : 包含題目

