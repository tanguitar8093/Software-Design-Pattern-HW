classDiagram
    direction TB
    class GeneticAlgorithm~G~ {
        <<abstract>>
        -problem : GeneticProblem~G~
        -selection : Selection~G~
        -config : GAConfig
        #random : Random
        +solve() Optional~Individual~
        #createIndividual() Individual~G~
        -initializePopulation() Population~G~
        -reproduce(population) Population~G~
        -findBest(population) Optional~Individual~
    }
    class SchedulingGA {
        #createIndividual() Individual~ProductionProduct~
    }
    class RecommendationGA {
        #createIndividual() Individual~Product~
    }
    class GeneticProblem~G~ {
        <<interface>>
        +evaluate(individual) Fitness
        +crossover(first, second, random) Individual~G~
        +mutate(individual, random) Individual~G~
    }
    class Selection~G~ {
        <<interface>>
        +select(population, problem, random) Individual~G~
    }
    class TournamentSelection~G~ {
        +select(population, problem, random) Individual~G~
    }
    class Population~G~ {
        -individuals : List~Individual~
        +individuals() List~Individual~
    }
    class Individual~G~ {
        -chromosome : Chromosome~G~
        +chromosome() Chromosome~G~
    }
    class Chromosome~G~ {
        -genes : List~G~
        +genes() List~G~
    }
    class Fitness {
        +feasible : boolean
        +score : double
        +compareTo(other) int
    }
    class GAConfig {
        +populationSize : int
        +maxIterations : int
        +crossoverRate : double
        +mutationRate : double
    }
    class SchedulingProblem {
        -demands : List~ProductionDemand~
        -machines : List~Machine~
        -workers : List~Worker~
        +createIndividual(random) Individual~ProductionProduct~
        +evaluate(individual) Fitness
        +crossover(first, second, random) Individual~ProductionProduct~
        +mutate(individual, random) Individual~ProductionProduct~
        +decode(individual) Schedule
    }
    class RecommendationProblem {
        -products : List~Product~
        -budget : int
        -capacity : int
        -preferences : Map~Category_double~
        +createIndividual(random) Individual~Product~
        +evaluate(individual) Fitness
        +crossover(first, second, random) Individual~Product~
        +mutate(individual, random) Individual~Product~
    }
    class ProductionDemand {
        +product : ProductionProduct
        +quantity : int
    }
    class ProductionProduct {
        +id : String
        +durationHours : int
    }
    class Machine {
        +id : String
    }
    class Worker {
        +id : String
    }
    class Schedule {
        +tasks : List~ProductionTask~
        +completionHours : int
    }
    class ProductionTask {
        +product : ProductionProduct
        +machine : Machine
        +worker : Worker
        +startHour : int
        +endHour : int
    }
    class Product {
        +id : String
        +price : int
        +weight : int
        +category : Category
    }
    class Category {
        <<enumeration>>
        A
        B
        C
    }
