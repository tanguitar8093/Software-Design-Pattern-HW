classDiagram
    direction TB

    %% ================================================================
    %% 【第一層：社群領域層 Waterball Community Domain】
    %% 觀察者模式 (Observer Pattern)：基礎頻道為 Subject，Bot 為 Observer
    %% ================================================================
    class Participant {
        <<abstract>>
        +id: String
    }

    class Member {
        +role: Role
        +sendMessage(chatRoom: ChatRoom, content: String, tags: List~String~) void
        +publishPost(forum: Forum, title: String, content: String, tags: List~String~) void
        +commentPost(forum: Forum, postId: String, content: String, tags: List~String~) void
        +startBroadcast(broadcast: Broadcast) void
        +speak(broadcast: Broadcast, content: String) void
        +stopBroadcast(broadcast: Broadcast) void
    }

    class Role {
        <<enumeration>>
        ADMIN
        MEMBER
    }

    class CommunityObserver {
        <<interface, Observer>>
        +onMessageReceived(message: Message) void
        +onPostPublished(post: Post) void
        +onBroadcastStarted(speakerId: String) void
        +onVoiceSpoken(voiceMessage: VoiceMessage) void
        +onBroadcastStopped(speakerId: String) void
        +onTimeElapsed(seconds: int) void
    }

    class WaterballCommunity {
        +currentTime: DateTime
        +login(participant: Participant) void
        +logout(participantId: String) void
        +elapseTime(amount: int, unit: String) void
        +getOnlineParticipants() List~Participant~
        +getOnlineCount() int
        +subscribe(observer: CommunityObserver) void
    }

    class ChatRoom {
        +postMessage(message: Message) void
        +subscribe(observer: CommunityObserver) void
    }

    class Forum {
        +createPost(post: Post) void
        +addComment(postId: String, comment: Comment) void
        +subscribe(observer: CommunityObserver) void
    }

    class Broadcast {
        +currentSpeakerId: String
        +start(speakerId: String) void
        +speak(voiceMessage: VoiceMessage) void
        +stop(speakerId: String) void
        +isBroadcasting() bool
        +subscribe(observer: CommunityObserver) void
    }

    class Message {
        +authorId: String
        +content: String
        +tags: List~String~
    }

    class Post {
        +id: String
        +authorId: String
        +title: String
        +content: String
        +tags: List~String~
        +addComment(comment: Comment) void
    }

    class Comment {
        +authorId: String
        +content: String
        +tags: List~String~
    }

    class VoiceMessage {
        +speakerId: String
        +content: String
    }

    class RecordingSession {
        +recorderId: String
        +addVoice(message: VoiceMessage) void
        +generateReplay() String
    }

    class KnowledgeKingGame {
        +currentQuestionIndex: int
        +startTime: DateTime
        +getCurrentQuestion() Question
        +submitAnswer(memberId: String, answer: String) bool
        +isFinished() bool
        +isTimeout(currentTime: DateTime) bool
        +getWinner() String
    }

    class Question {
        +number: int
        +description: String
        +options: List~String~
        +correctAnswer: String
        +isCorrect(answer: String) bool
    }

    %% 領域層結構與關聯
    Participant <|-- Member
    Member --> Role
    WaterballCommunity "1" *-- "1" ChatRoom
    WaterballCommunity "1" *-- "1" Forum
    WaterballCommunity "1" *-- "1" Broadcast
    WaterballCommunity "1" *-- "1" Bot : 常駐
    WaterballCommunity "1" o-- "0..*" Participant : 在線名單
    ChatRoom "1" *-- "0..*" Message
    Forum "1" *-- "0..*" Post
    Post "1" *-- "0..*" Comment
    Broadcast "1" *-- "0..*" VoiceMessage
    KnowledgeKingGame "1" *-- "3" Question : 包含題庫
    RecordingSession "1" o-- "0..*" VoiceMessage : 記錄語音內容

    %% 觀察者推播關聯
    ChatRoom ..> CommunityObserver : notify (收到訊息)
    Forum ..> CommunityObserver : notify (發布貼文)
    Broadcast ..> CommunityObserver : notify (上麥/發言/下麥)
    WaterballCommunity ..> CommunityObserver : notify (時間流逝)

    %% ================================================================
    %% 【第二層：FSM 模組 Finite-State Machine Module】
    %% 狀態模式 (State) + 複合模式 (Composite) + 策略模式 (Strategy)
    %% ================================================================
    class FiniteStateMachine {
        +initialState: State
        +currentState: State
        +transitions: List~Transition~
        +fire(event: String) void
        +getCurrentState() State
    }

    class State {
        <<interface, Composite Component>>
        +onEnter() void
        +onExit() void
        +handle(event: String) void
    }

    class AtomicState {
        <<abstract, Composite Leaf>>
        +onEnter() void
        +onExit() void
        +handle(event: String) void
    }

    class CompositeState {
        <<abstract, Composite Composite>>
        +subFsm: FiniteStateMachine
        +onEnter() void
        +onExit() void
        +handle(event: String) void
        +addState(state: State) void
    }

    class Transition {
        +fromState: State
        +toState: State
        +event: String
        +guard: Guard
        +action: Action
        +trigger(event: String) bool
        +isSatisfied() bool
        +executeAction() void
    }

    class Guard {
        <<interface, Strategy>>
        +isSatisfied() bool
    }

    class Action {
        <<interface, Strategy>>
        +execute() void
    }

    %% FSM 複合模式與結構關聯
    State <|.. AtomicState
    State <|.. CompositeState
    CompositeState "1" *-- "1" FiniteStateMachine : 內嵌子狀態機
    FiniteStateMachine "1" o-- "1..*" State : 管理狀態集
    FiniteStateMachine "1" *-- "0..*" Transition : 擁有轉移集合
    Transition --> State : fromState / toState
    Transition o-- "0..1" Guard : 守衛條件 (Strategy)
    Transition o-- "0..1" Action : 轉移動作 (Strategy)

    %% ================================================================
    %% 【第三層：Bot 模組 Waterball Bot Module】
    %% 門面模式 (Facade) + 指令模式 (Command) + 樣板方法模式 (Template Method)
    %% ================================================================
    class BotFacade {
        <<Facade>>
        +state(name: String) BotFacade
        +command(name: String, cmd: BotCommand) BotFacade
        +transition(from: String, to: String, event: String) BotFacade
        +build() Bot
    }

    class Bot {
        +id: String = "bot"
        +quota: int
        +replyCycleIndex: int
        -fsm: FiniteStateMachine
        -commands: Map~String, BotCommand~
        +registerCommand(name: String, cmd: BotCommand) void
        +executeCommand(cmdName: String, member: Member) void
        +onMessageReceived(message: Message) void
        +onPostPublished(post: Post) void
        +onBroadcastStarted(speakerId: String) void
        +onVoiceSpoken(voiceMessage: VoiceMessage) void
        +onBroadcastStopped(speakerId: String) void
        +onTimeElapsed(seconds: int) void
        +replyChatMessage(content: String, tags: List~String~) void
        +commentPost(postId: String, content: String, tags: List~String~) void
        +broadcastVoice(content: String) void
        +resetReplyCycle() void
        +getNextReplyMessage() String
    }

    %% 指令模式與樣板方法模式
    class BotCommand {
        <<interface, Command>>
        +execute(bot: Bot, member: Member) void
    }

    class AbstractBotCommand {
        <<abstract, Template Method>>
        +execute(bot: Bot, member: Member) void
        #checkQuota(bot: Bot) bool
        #checkPermission(member: Member) bool
        #deductQuota(bot: Bot) void
        #doExecute(bot: Bot, member: Member)* void
    }

    class KingCommand
    class RecordCommand
    class StopRecordingCommand
    class KingStopCommand
    class PlayAgainCommand

    %% 具體策略實作 (Guards & Actions)
    class PermissionGuard {
        -requiredRole: Role
        +isSatisfied() bool
    }
    class QuotaGuard {
        -requiredQuota: int
        +isSatisfied() bool
    }
    class DeductQuotaAction {
        -cost: int
        +execute() void
    }
    class ResetReplyCycleAction {
        +execute() void
    }

    %% 具體狀態階層 (繼承 CompositeState 與 AtomicState)
    class NormalState {
        <<Composite>>
    }
    class DefaultConversationState {
        <<Leaf>>
    }
    class InteractingState {
        <<Leaf>>
    }

    class RecordState {
        <<Composite>>
        -session: RecordingSession
    }
    class WaitingState {
        <<Leaf>>
    }
    class RecordingState {
        <<Leaf>>
    }

    class KnowledgeKingState {
        <<Composite>>
        -game: KnowledgeKingGame
    }
    class QuestioningState {
        <<Leaf>>
    }
    class ThanksForJoiningState {
        <<Leaf>>
    }

    %% Bot 關聯與實作
    Participant <|-- Bot
    CommunityObserver <|.. Bot : 監聽社群事件
    Bot "1" *-- "1" FiniteStateMachine : 驅動狀態機
    Bot "1" o-- "0..*" BotCommand : 註冊與持有指令集合 (Invoker)
    BotFacade ..> Bot : build()
    BotFacade ..> BotCommand : 註冊指令設定
    BotFacade ..> FiniteStateMachine : 組裝 FSM 與轉移

    %% Command 繼承體系
    BotCommand <|.. AbstractBotCommand
    AbstractBotCommand <|-- KingCommand
    AbstractBotCommand <|-- RecordCommand
    AbstractBotCommand <|-- StopRecordingCommand
    AbstractBotCommand <|-- KingStopCommand
    AbstractBotCommand <|-- PlayAgainCommand

    %% Command 對 Receiver 的呼叫 (依據 ood分析.md 之 Command SOP 描述)
    KingCommand ..> KnowledgeKingGame : 啟動遊戲 (Receiver)
    KingCommand ..> FiniteStateMachine : 觸發轉移進入知識王狀態
    RecordCommand ..> RecordingSession : 初始化錄音會話 (Receiver)
    RecordCommand ..> FiniteStateMachine : 觸發轉移進入錄音狀態
    StopRecordingCommand ..> RecordingSession : 產出 Replay
    StopRecordingCommand ..> FiniteStateMachine : 觸發轉移回正常狀態
    PlayAgainCommand ..> KnowledgeKingGame : 重啟遊戲
    KingStopCommand ..> FiniteStateMachine : 觸發轉移回正常狀態

    %% Strategy 實作關聯
    Guard <|.. PermissionGuard
    Guard <|.. QuotaGuard
    Action <|.. DeductQuotaAction
    Action <|.. ResetReplyCycleAction

    %% 狀態繼承與複合層級
    CompositeState <|-- NormalState
    CompositeState <|-- RecordState
    CompositeState <|-- KnowledgeKingState
    AtomicState <|-- DefaultConversationState
    AtomicState <|-- InteractingState
    AtomicState <|-- WaitingState
    AtomicState <|-- RecordingState
    AtomicState <|-- QuestioningState
    AtomicState <|-- ThanksForJoiningState

    %% 狀態對領域實體之持有與操作
    RecordState "1" o-- "0..1" RecordingSession : 進行錄音會話
    KnowledgeKingState "1" o-- "0..1" KnowledgeKingGame : 主持知識王遊戲

    %% ================================================================
    %% 【第四層：應用層 Application Layer】
    %% ================================================================
    class Client {
        +main() void
    }

    Client --> WaterballCommunity : 驅動生命週期與時間
    Client --> Member : 觸發發言/發文/廣播
    Client --> BotFacade : 宣告配置機器人

    %% 便條紙：設計模式標註與說明
    note for BotFacade "【門面模式 Facade】\n封裝 FSM 模組組裝細節（Transition、Guard、Action），\n提供高階流暢介面降低開發者認知負擔"
    note for CompositeState "【複合模式 Composite】\nCompositeState 與 AtomicState 共同實作 State 介面，\n支援任意深度子狀態機的巢狀嵌套與統一調度"
    note for CommunityObserver "【觀察者模式 Observer】\nChatRoom、Forum、Broadcast、WaterballCommunity 發布事件，\n解耦頻道與機器人，支援未來擴充新監聽器"
    note for AbstractBotCommand "【樣板方法 Template Method & 指令模式 Command】\nexecute() 規範固定流程：驗證 Quota → 驗證權限 → 扣除 Quota → doExecute()，\n具體指令僅需覆寫 doExecute() 執行狀態切換或業務"
    note for Guard "【策略模式 Strategy】\nGuard (條件) 與 Action (動作) 抽成獨立策略介面，\n可動態注入至 Transition 中彈性組合"
