stateDiagram-v2
    direction LR

    [*] --> DefaultConversation: [community.getOnlineCount() < 10]
    [*] --> Interacting: [community.getOnlineCount() >= 10]

    state "Default Conversation" as DefaultConversation
    state "Interacting" as Interacting
    state "Waiting" as Waiting
    state "Recording" as Recording
    state "Questioning" as Questioning
    state "Thanks For Joining" as ThanksForJoining

    %% ==========================================
    %% 狀態內部行為 (Internal State Behaviors)
    %% ==========================================
    DefaultConversation: entry / resetReplyCycle("good to hear")
    DefaultConversation: onMessageReceived(msg) / Bot.replyChatMessage(cycleReply, [msg.authorId])
    DefaultConversation: onPostPublished(post) / Bot.commentPost(post.id, "Nice post", [post.authorId])

    Interacting: entry / resetReplyCycle("Hi hi😁")
    Interacting: onMessageReceived(msg) / Bot.replyChatMessage(cycleReply, [msg.authorId])
    Interacting: onPostPublished(post) / Bot.commentPost(post.id, "How do you guys think about it?", community.getOnlineParticipants())

    Waiting: entry / retain recordingSession
    Recording: onVoiceSpoken(voiceMsg) / RecordingSession.addVoice(voiceMsg)

    ThanksForJoining: entry / if (!Broadcast.isBroadcasting()) Bot.broadcastVoice(Game.getWinner()) else Bot.replyChatMessage(Game.getWinner(), [])

    %% ==========================================
    %% 正常狀態間切換 (在線人數門檻)
    %% ==========================================
    DefaultConversation --> Interacting: login [community.getOnlineCount() >= 10]
    Interacting --> DefaultConversation: logout [community.getOnlineCount() < 10]

    %% ==========================================
    %% 進入錄音狀態 (record 指令)
    %% ==========================================
    DefaultConversation --> Waiting: onMessageReceived("record @bot") [quota >= 3 && !Broadcast.isBroadcasting()]<br/>/ Bot.replyChatMessage(cycleReply, [author]) + quota-=3 + init RecordingSession(author)
    DefaultConversation --> Recording: onMessageReceived("record @bot") [quota >= 3 && Broadcast.isBroadcasting()]<br/>/ Bot.replyChatMessage(cycleReply, [author]) + quota-=3 + init RecordingSession(author)
    Interacting --> Waiting: onMessageReceived("record @bot") [quota >= 3 && !Broadcast.isBroadcasting()]<br/>/ Bot.replyChatMessage(cycleReply, [author]) + quota-=3 + init RecordingSession(author)
    Interacting --> Recording: onMessageReceived("record @bot") [quota >= 3 && Broadcast.isBroadcasting()]<br/>/ Bot.replyChatMessage(cycleReply, [author]) + quota-=3 + init RecordingSession(author)

    %% ==========================================
    %% 錄音內部轉移 (廣播開麥 / 閉麥)
    %% ==========================================
    Waiting --> Recording: onBroadcastStarted(speakerId)
    Recording --> Waiting: onBroadcastStopped(speakerId)<br/>/ Bot.replyChatMessage(RecordingSession.generateReplay(), [recorderId])

    %% ==========================================
    %% 結束錄音狀態 (stop-recording 指令)
    %% ==========================================
    Waiting --> DefaultConversation: onMessageReceived("stop-recording @bot") [msg.authorId == session.recorderId && community.getOnlineCount() < 10]
    Waiting --> Interacting: onMessageReceived("stop-recording @bot") [msg.authorId == session.recorderId && community.getOnlineCount() >= 10]
    Recording --> DefaultConversation: onMessageReceived("stop-recording @bot") [msg.authorId == session.recorderId && community.getOnlineCount() < 10]<br/>/ Bot.replyChatMessage(RecordingSession.generateReplay(), [recorderId])
    Recording --> Interacting: onMessageReceived("stop-recording @bot") [msg.authorId == session.recorderId && community.getOnlineCount() >= 10]<br/>/ Bot.replyChatMessage(RecordingSession.generateReplay(), [recorderId])

    %% ==========================================
    %% 進入知識王狀態 (king 指令)
    %% ==========================================
    DefaultConversation --> Questioning: onMessageReceived("king @bot") [author.role == Role.ADMIN && quota >= 5]<br/>/ Bot.replyChatMessage(cycleReply, [author]) + quota-=5 + init KnowledgeKingGame() + Bot.replyChatMessage("KnowledgeKing is started!", []) + Bot.replyChatMessage(Game.getCurrentQuestion().description, [])
    Interacting --> Questioning: onMessageReceived("king @bot") [author.role == Role.ADMIN && quota >= 5]<br/>/ Bot.replyChatMessage(cycleReply, [author]) + quota-=5 + init KnowledgeKingGame() + Bot.replyChatMessage("KnowledgeKing is started!", []) + Bot.replyChatMessage(Game.getCurrentQuestion().description, [])

    %% ==========================================
    %% 知識王答題、推進與結算
    %% ==========================================
    Questioning --> Questioning: onMessageReceived(ans) [Game.submitAnswer(author.id, ans) && !Game.isFinished()]<br/>/ Bot.replyChatMessage("Congrats! you got the answer!", [author.id]) + Bot.replyChatMessage(Game.getCurrentQuestion().description, [])
    Questioning --> ThanksForJoining: onMessageReceived(ans) [Game.submitAnswer(author.id, ans) && Game.isFinished()]<br/>/ Bot.replyChatMessage("Congrats! you got the answer!", [author.id])
    Questioning --> ThanksForJoining: onTimeElapsed(seconds) [Game.isTimeout(community.currentTime)]

    %% 再玩一次
    Questioning --> Questioning: onMessageReceived("play again @bot") [quota >= 5]<br/>/ quota-=5 + Bot.replyChatMessage("KnowledgeKing is gonna start again!", []) + init KnowledgeKingGame() + Bot.replyChatMessage(Game.getCurrentQuestion().description, [])
    ThanksForJoining --> Questioning: onMessageReceived("play again @bot") [quota >= 5]<br/>/ quota-=5 + Bot.replyChatMessage("KnowledgeKing is gonna start again!", []) + init KnowledgeKingGame() + Bot.replyChatMessage(Game.getCurrentQuestion().description, [])

    %% ==========================================
    %% 退出知識王狀態 (king-stop 指令 或 20秒超時)
    %% ==========================================
    Questioning --> DefaultConversation: onMessageReceived("king-stop @bot") [author.role == Role.ADMIN && community.getOnlineCount() < 10]
    Questioning --> Interacting: onMessageReceived("king-stop @bot") [author.role == Role.ADMIN && community.getOnlineCount() >= 10]
    ThanksForJoining --> DefaultConversation: onMessageReceived("king-stop @bot") [author.role == Role.ADMIN && community.getOnlineCount() < 10]
    ThanksForJoining --> Interacting: onMessageReceived("king-stop @bot") [author.role == Role.ADMIN && community.getOnlineCount() >= 10]

    ThanksForJoining --> DefaultConversation: onTimeElapsed(20) [community.getOnlineCount() < 10]
    ThanksForJoining --> Interacting: onTimeElapsed(20) [community.getOnlineCount() >= 10]
